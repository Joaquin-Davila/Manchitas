# Copia este archivo a .env y llena los valores. .env no se sube a git.
# Todavía no hay proyecto de Supabase: la app usa datos de ejemplo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dominio público donde estará publicada la app (sin diagonal final), p. ej. https://manchitas.example
# Es la base de la URL que codifica el QR. Si se deja vacío, usa el origen actual (localhost en desarrollo).
VITE_URL_PUBLICA=
